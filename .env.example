# Copy this file to .env and fill in real values. Never commit .env.
# Generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=8080                       # public gateway port (Render/Railway/Heroku set this automatically)
USER_SERVICE_PORT=4001
COMPLAINT_SERVICE_PORT=4002
GEO_SERVICE_PORT=4003
TRUST_PROXY=0                   # number of proxies in front of the app: 3 on Render (verified), usually 1 on Railway/Heroku

# --- Secrets (required) -------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
INTERNAL_SERVICE_KEY=replace-with-another-random-secret
API_KEYS=replace-with-a-client-api-key   # comma-separated list, one per client app

# --- Seeded admin account -----------------------------------------------------
ADMIN_NAME=City Admin
ADMIN_EMAIL=admin@smartcity.local
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PHONE=+919999999999

# --- Gateway ------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100              # requests per window per API key
AUTH_RATE_LIMIT_MAX=10          # login/register attempts per window per IP
CORS_ORIGINS=                   # e.g. https://my-frontend.example.com (empty = allow all, dev only)

# --- Geocoding: nominatim (OpenStreetMap, free) | google | mock ----------------
GEOCODER_PROVIDER=nominatim
NOMINATIM_USER_AGENT=SmartCityPortal/2.0 (BITS student project)
GEOCODER_COUNTRY_CODES=in       # restrict results to India; leave empty for worldwide
GOOGLE_MAPS_API_KEY=            # only needed when GEOCODER_PROVIDER=google

# --- SMS: mock (stub, default) | twilio ---------------------------------------
SMS_PROVIDER=mock
# Twilio test credentials (Console > Account > API keys & tokens > Test credentials)
# never send real messages and are free. Use +15005550006 as the From number with them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

LOG_REQUESTS=true
